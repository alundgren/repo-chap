{
  "name": "@repo-chap/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "docs:build": "python3 docs/pr-workflows/build_presentation.py",
    "docs:browser": "node docs/pr-workflows/check-presentation.mjs",
    "browser:install": "playwright install chromium webkit",
    "build": "pnpm --filter @repo-chap/workflow build && pnpm --filter @repo-chap/slack build && pnpm --filter @repo-chap/github build && pnpm --filter @repo-chap/providers build && pnpm --filter @repo-chap/execution build && pnpm --filter @repo-chap/runtime build && pnpm --filter @repo-chap/daemon build && pnpm --filter repo-chap build",
    "typecheck": "pnpm build && tsc --noEmit --allowImportingTsExtensions",
    "test": "pnpm build && node --test --test-reporter=dot tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@repo-chap/workflow": "workspace:*",
    "@types/node": "^24.13.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "@repo-chap/github": "workspace:*",
    "@repo-chap/providers": "workspace:*",
    "@repo-chap/execution": "workspace:*",
    "@repo-chap/runtime": "workspace:*",
    "@repo-chap/daemon": "workspace:*",
    "@repo-chap/slack": "workspace:*"
  }
}
