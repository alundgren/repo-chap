{
  "schemaVersion": 1,
  "id": "team-pr",
  "version": "0.1.0",
  "settings": {
    "newPrDelaySeconds": 120,
    "headDebounceSeconds": 30,
    "reviewWaitSeconds": 300,
    "reviewDeadlineSeconds": 1800,
    "mergeMode": "human"
  },
  "limits": {
    "maxAttemptsPerHead": 2,
    "maxRepairsPerLifecycle": 4,
    "maxAgentActionsPerWake": 3,
    "maxAttemptSeconds": 900,
    "maxDailyCostUnits": 100
  },
  "requestedCapabilities": [
    "workspace.read",
    "workspace.write",
    "checks.run",
    "pr.push",
    "review.resolve",
    "notify.send"
  ],
  "labels": [
    "security",
    "ux",
    "auth",
    "db_migration",
    "tests",
    "other"
  ],
  "rules": [
    {
      "id": "closed",
      "when": {
        "any": [
          {
            "field": "facts.lifecycle",
            "op": "eq",
            "value": "closed"
          },
          {
            "field": "facts.lifecycle",
            "op": "eq",
            "value": "merged"
          }
        ]
      },
      "action": "stop"
    },
    {
      "id": "draft",
      "when": {
        "field": "facts.draft",
        "op": "eq",
        "value": true
      },
      "action": "park"
    },
    {
      "id": "missing_evidence",
      "when": {
        "field": "facts.evidenceComplete",
        "op": "eq",
        "value": false
      },
      "action": "wait_refresh"
    },
    {
      "id": "new_or_changed",
      "when": {
        "any": [
          {
            "field": "facts.young",
            "op": "eq",
            "value": true
          },
          {
            "field": "facts.headDebouncing",
            "op": "eq",
            "value": true
          }
        ]
      },
      "action": "wait_debounce"
    },
    {
      "id": "repair_waiting_human",
      "when": {
        "all": [
          {
            "field": "memory.repairSuppressed",
            "op": "eq",
            "value": true
          },
          {
            "any": [
              {
                "field": "facts.conflict",
                "op": "eq",
                "value": true
              },
              {
                "field": "facts.unaddressedReview",
                "op": "eq",
                "value": true
              },
              {
                "field": "facts.ciFailed",
                "op": "eq",
                "value": true
              }
            ]
          }
        ]
      },
      "action": "park"
    },
    {
      "id": "conflict",
      "when": {
        "field": "facts.conflict",
        "op": "eq",
        "value": true
      },
      "action": "resolve_conflict"
    },
    {
      "id": "review_to_address",
      "when": {
        "field": "facts.unaddressedReview",
        "op": "eq",
        "value": true
      },
      "action": "address"
    },
    {
      "id": "ci_running",
      "when": {
        "field": "facts.ciPending",
        "op": "eq",
        "value": true
      },
      "action": "wait_ci"
    },
    {
      "id": "ci_failed",
      "when": {
        "field": "facts.ciFailed",
        "op": "eq",
        "value": true
      },
      "action": "fix_ci"
    },
    {
      "id": "reviewer_active",
      "when": {
        "field": "facts.externalReviewPending",
        "op": "eq",
        "value": true
      },
      "action": "wait_review"
    },
    {
      "id": "classify_current_head",
      "when": {
        "field": "memory.classificationCurrent",
        "op": "eq",
        "value": false
      },
      "action": "classify"
    },
    {
      "id": "review_current_head",
      "when": {
        "field": "memory.reviewCurrent",
        "op": "eq",
        "value": false
      },
      "action": "review"
    },
    {
      "id": "request_human_decision",
      "when": {
        "field": "memory.packetCurrent",
        "op": "eq",
        "value": false
      },
      "action": "handoff"
    }
  ],
  "otherwise": "park",
  "actions": {
    "stop": {
      "execution": "code",
      "uses": "control.close",
      "capabilities": [],
      "onSuccess": "$closed",
      "onFailure": "$blocked"
    },
    "park": {
      "execution": "code",
      "uses": "control.wait_signal",
      "capabilities": [],
      "onSuccess": "$wait",
      "onFailure": "$blocked"
    },
    "wait_refresh": {
      "execution": "code",
      "uses": "control.wait_refresh",
      "capabilities": [],
      "onSuccess": "$wait",
      "onFailure": "$blocked"
    },
    "wait_debounce": {
      "execution": "code",
      "uses": "control.wait_debounce",
      "capabilities": [],
      "onSuccess": "$wait",
      "onFailure": "$blocked"
    },
    "wait_review": {
      "execution": "code",
      "uses": "control.wait_reviewer",
      "capabilities": [],
      "onSuccess": "$wait",
      "onFailure": "$blocked"
    },
    "resolve_conflict": {
      "execution": "agent",
      "uses": "agent.resolve_conflict",
      "capabilities": [
        "workspace.read",
        "workspace.write"
      ],
      "onSuccess": "validate_candidate",
      "onFailure": "handoff",
      "prompt": "prompts/resolve-conflict.md",
      "outputSchema": "../../schemas/results.schema.json#/$defs/candidate"
    },
    "address": {
      "execution": "agent",
      "uses": "agent.address_review",
      "capabilities": [
        "workspace.read",
        "workspace.write"
      ],
      "onSuccess": "validate_candidate",
      "onFailure": "handoff",
      "prompt": "prompts/address.md",
      "outputSchema": "../../schemas/results.schema.json#/$defs/candidate"
    },
    "validate_candidate": {
      "execution": "code",
      "uses": "checks.validate_candidate",
      "capabilities": [
        "checks.run"
      ],
      "onSuccess": "push_candidate",
      "onFailure": "handoff"
    },
    "push_candidate": {
      "execution": "code",
      "uses": "github.push_candidate",
      "capabilities": [
        "pr.push"
      ],
      "onSuccess": "resolve_threads",
      "onFailure": "handoff"
    },
    "resolve_threads": {
      "execution": "code",
      "uses": "github.resolve_eligible_threads",
      "capabilities": [
        "review.resolve"
      ],
      "onSuccess": "$observe",
      "onFailure": "handoff"
    },
    "classify": {
      "execution": "agent",
      "uses": "agent.classify",
      "capabilities": [
        "workspace.read"
      ],
      "onSuccess": "$observe",
      "onFailure": "handoff",
      "prompt": "prompts/classify.md",
      "outputSchema": "../../schemas/results.schema.json#/$defs/classification"
    },
    "review": {
      "execution": "agent",
      "uses": "agent.review",
      "capabilities": [
        "workspace.read"
      ],
      "onSuccess": "$observe",
      "onFailure": "handoff",
      "prompt": "prompts/review.md",
      "outputSchema": "../../schemas/results.schema.json#/$defs/review",
      "contextFiles": [
        "review.md"
      ]
    },
    "handoff": {
      "execution": "code",
      "uses": "human.publish_packet",
      "capabilities": [
        "notify.send"
      ],
      "onSuccess": "$wait",
      "onFailure": "$blocked"
    },
    "wait_ci": {
      "execution": "code",
      "uses": "control.wait_signal",
      "capabilities": [],
      "onSuccess": "$wait",
      "onFailure": "$blocked"
    },
    "fix_ci": {
      "execution": "agent",
      "uses": "agent.fix_ci",
      "capabilities": [
        "workspace.read",
        "workspace.write"
      ],
      "onSuccess": "validate_candidate",
      "onFailure": "handoff",
      "prompt": "prompts/fix-ci.md",
      "outputSchema": "../../schemas/results.schema.json#/$defs/candidate"
    }
  },
  "slack": {
    "workspaceId": "T012EXAMPLE",
    "users": {
      "example-author": "U012EXAMPLE"
    },
    "channels": {
      "team": "C012EXAMPLE"
    },
    "defaultChannel": "team",
    "routes": {
      "needs_author": "author_dm",
      "needs_team": "team",
      "ready_for_human_merge": "team",
      "blocked_execution": "team"
    }
  }
}
